# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for the automatic live/latest channel feed on the public site.
YOUTUBE_API_KEY=
# Optional; defaults to the Sukawarna Legacy channel.
YOUTUBE_CHANNEL_ID=

# Public editorial content. Set this to the LSS API when the read cutover is approved.
NEXT_PUBLIC_CONTENT_API_URL=
# Temporary compatibility source used only while the LSS content API is not configured.
NEXT_PUBLIC_API_URL=
# Set to true only after the writer-freeze gate; redirects legacy dashboard/auth routes to the public site.
NEXT_PUBLIC_PUBLIC_SITE_ONLY=false
